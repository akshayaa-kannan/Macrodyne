def extract_numbers(pdf_path):
    doc = fitz.open(pdf_path)
    final = []

    for page_index, page in enumerate(doc):
        pw, ph = page.rect.width, page.rect.height

        DRAWING_TOP = ph * 0.08        # below title
        DRAWING_BOTTOM = ph * 0.72     # above CERTIFIED + title block

        for block in page.get_text("dict")["blocks"]:
            if block["type"] != 0:
                continue

            for line in block["lines"]:
                for span in line["spans"]:
                    x0, y0, x1, y1 = span["bbox"]
                    text = span["text"]

                    if span["size"] < 6:
                        continue

                    # ✅ ONLY DRAWING AREA
                    if not (DRAWING_TOP < y0 < DRAWING_BOTTOM):
                        continue

                    upper = text.upper()

                    # ❌ Kill obvious non-drawing text
                    if any(k in upper for k in [
                        "NOTE", "ITEM", "QTY", "DWG",
                        "REV", "SHEET", "SCALE",
                        "MATERIAL", "WEIGHT",
                        "PROPRIETARY", "CONFIDENTIAL"
                    ]):
                        continue

                    for match in re.finditer(REGEX, text, re.VERBOSE):
                        final.append({
                            "page": page_index,
                            "value": match.group().strip(),
                            "x": x0,
                            "y": (y0 + y1) / 2
                        })

    return final






